{
  "framework": "nextjs",
  "buildCommand": "prisma migrate deploy && prisma generate && next build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 0 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "(?:www\\.)?shipsafecli\\.com"
        }
      ],
      "destination": "https://shipsafe.sh/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/og-shipsafe.jpg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
